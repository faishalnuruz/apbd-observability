{
  "uid": "apbd-observability",
  "title": "APBD Data Quality & Governance",
  "tags": [
    "apbd",
    "data-quality",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Portfolio quality score (0-100)",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apbd_quality_score_portfolio",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Score per table",
      "type": "bargauge",
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apbd_quality_score",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Catalog & audit",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apbd_catalog_tables",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(apbd_audit_events_total{decision=\"denied\"})",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum(apbd_audit_events_total{decision=\"allowed\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Freshness per table (jam sejak update; PRD: warn 2h, error 4h)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apbd_freshness_hours",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "Contract check status (1 PASS, 0.5 WARN, 0 FAIL)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": -0.1,
          "max": 1.1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apbd_check_status",
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Failing checks (latest)",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apbd_check_status < 1",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "project": true
            }
          }
        }
      ]
    }
  ]
}
